{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "#ui/*": ["./node_modules/@nuxt/ui/dist/runtime/*"],
      "#imports": [".nuxt/imports.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist"
  ]
}
